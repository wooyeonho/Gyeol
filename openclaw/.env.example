# Required — direct execution needs DB + AI access
GYEOL_APP_URL=https://your-app.vercel.app
CRON_SECRET=your-cron-secret-min-32-chars
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Optional
PORT=8000
USE_HMAC_AUTH=false

# Web crawling (comma-separated seed URLs)
CRAWL_URLS=https://news.ycombinator.com,https://techcrunch.com
CRAWL_MAX_PAGES=10
CRAWL_DEPTH=1
