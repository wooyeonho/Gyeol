# ── Required ──────────────────────────────────
# OpenClaw gateway + Gyeol cron-core need these
GYEOL_APP_URL=https://your-app.vercel.app
CRON_SECRET=your-cron-secret-min-32-chars
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROQ_API_KEY=your-groq-api-key

# ── Optional ─────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
PORT=8000

# Web crawling (comma-separated seed URLs)
CRAWL_URLS=https://news.ycombinator.com,https://techcrunch.com
CRAWL_MAX_PAGES=10
CRAWL_DEPTH=1

# ── OpenClaw Gateway ─────────────────────────
# Config file location (default: ./openclaw.json5)
OPENCLAW_CONFIG=./openclaw.json5
OPENCLAW_HOME=/app/openclaw
