    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "next": "^16.2.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "zustand": "^5.0.12"
  }
}
