{
  "name": "gyeol-openclaw",
  "version": "3.0.0",
  "private": true,
  "description": "GYEOL autonomous engine — powered by OpenClaw open-source gateway",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node dist/openclaw/src/index.js",
    "dev": "tsx src/index.ts",
    "gateway": "openclaw gateway --port ${PORT:-8000} --verbose"
  },
  "dependencies": {
