# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Providers
GROQ_API_KEY=your-groq-api-key
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token
GEMINI_API_KEY=your-gemini-api-key

# Cron
# Used to authenticate scheduled job requests (Vercel cron / external scheduler)
CRON_SECRET=your-cron-secret-min-32-chars
# Safety switch for redemption cron stub (keep false unless intentionally enabling)
REDEMPTION_AUTO_APPROVE=false

# External API
# Legacy single-key fallback for v1 API (use api_keys table in production)
GYEOL_ENGINE_API_KEY=your-engine-api-key

# Research API (anonymized aggregate data endpoint)
RESEARCH_API_KEY=your-research-api-key

# Email (weekly summary webhook, optional)
EMAIL_API_URL=https://your-email-service.com/send

# App URL (required for Telegram webhook internal chat calls)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Telegram webhook secret token (required for webhook verification)
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Encryption key for user integration tokens (required for secure storage)
CONNECTION_TOKEN_KEY=your-32-plus-char-random-secret

# RSS Learner (optional, comma-separated feed URLs)
FEED_URLS=

# Web Crawling (optional, comma-separated seed URLs)
CRAWL_URLS=https://news.ycombinator.com,https://techcrunch.com
CRAWL_MAX_PAGES=10
CRAWL_DEPTH=1

# Integrations (optional)
NOTION_API_KEY=
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=

# Music (optional)
SUNO_API_KEY=

# Video (optional)
RUNWAYML_API_KEY=
