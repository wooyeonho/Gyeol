# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# For psql-based migration scripts
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# AI Providers
GROQ_API_KEY=your-groq-api-key
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token
GEMINI_API_KEY=your-gemini-api-key

# Cron
# Used to authenticate scheduled job requests (Vercel cron / external scheduler)
CRON_SECRET=your-cron-secret-min-32-chars
# Optional: Slack incoming webhook for operational alerts
OPS_ALERT_SLACK_WEBHOOK_URL=
# Optional: ops critical alert email receiver (used with EMAIL_API_URL)
OPS_ALERT_EMAIL_TO=
# Optional: comma-separated admin user ids allowed to open /ops APIs and screens
OPS_ADMIN_USER_IDS=
# Safety switch for redemption cron stub (keep false unless intentionally enabling)
REDEMPTION_AUTO_APPROVE=false
# Development/testing only. Keep false in production unless explicitly using mock billing.
ENABLE_MOCK_BILLING=false

# External API
# Legacy single-key fallback for v1 API (use api_keys table in production)
GYEOL_ENGINE_API_KEY=your-engine-api-key

# Research API (anonymized aggregate data endpoint)
RESEARCH_API_KEY=your-research-api-key

# Product event retention (days)
PRODUCT_EVENTS_RETENTION_DAYS=90

# Safety modes
# open: fail open, closed: fail closed
RATE_LIMIT_FAIL_MODE=open
CRON_LOCK_FAIL_MODE=open

# Referral reward (coins)
REFERRAL_REWARD_COINS=10

# Email (weekly summary / recap delivery)
# 내장 이메일 전송 엔드포인트를 쓰려면 EMAIL_API_URL=https://your-app.vercel.app/api/email/send
EMAIL_API_URL=
RESEND_API_KEY=
EMAIL_FROM=recap@yourdomain.com
# EMAIL_SEND_SECRET= (선택, CRON_SECRET 대신 사용)

# Stripe (optional until real billing is enabled)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# App URL (required for Telegram webhook internal chat calls)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# Optional deploy verification fallback
APP_URL=https://your-app.vercel.app

# OpenClaw worker -> app URL
GYEOL_APP_URL=https://your-app.vercel.app

# Telegram webhook secret token (required for webhook verification)
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# Encryption key for user integration tokens (required for secure storage)
CONNECTION_TOKEN_KEY=your-32-plus-char-random-secret

# RSS Learner (optional, comma-separated feed URLs)
FEED_URLS=

# Web Crawling (optional, comma-separated seed URLs)
CRAWL_URLS=https://news.ycombinator.com,https://techcrunch.com
CRAWL_MAX_PAGES=10
CRAWL_DEPTH=1
USE_HMAC_AUTH=false

# Integrations (optional)
NOTION_API_KEY=
SLACK_BOT_TOKEN=
GITHUB_TOKEN=
TELEGRAM_BOT_TOKEN=

# Music (optional)
SUNO_API_KEY=

# Video (optional)
RUNWAYML_API_KEY=
